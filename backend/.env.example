# ─────────────────────────────────────────────────────────────────────────────
# autoMITRE v1.2 — Environment Variable Configuration
#
# SETUP INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the values below
#   3. Never commit your .env file — it is listed in .gitignore
#
# Variables marked [REQUIRED] will cause features to break if missing.
# Variables marked [optional] degrade gracefully — the app still works.
# ─────────────────────────────────────────────────────────────────────────────


# ── Groq Cloud LLM [REQUIRED for AI analysis] ────────────────────────────────
# Powers the Stage 2 reasoning engine (Llama-3 via Groq Cloud).
# Without this key the LLM layer is skipped and only the local SecBERT
# model + heuristic keyword matching will produce results.
#
# Get a FREE key in under 60 seconds:
#   1. Go to https://console.groq.com
#   2. Sign up / Log in
#   3. Click "API Keys" → "Create API Key"
#   4. Paste the key below
#
GROQ_API_KEY=your-groq-api-key-here


# ── Framework Toggles ────────────────────────────────────────────────────────
# Set to "true" to enable mapping to each framework, "false" to disable.
# All are enabled by default.
FRAMEWORK_ATTACK=true
FRAMEWORK_DEFEND=true
FRAMEWORK_NIST=true
FRAMEWORK_OWASP=true


# ── OSINT Feed Settings ───────────────────────────────────────────────────────
# How long to cache OSINT feed results in seconds (default: 300 = 5 minutes)
OSINT_CACHE_TTL=300
# Max number of OSINT indicators to fetch per query
OSINT_LIMIT=50
# Minimum severity for OSINT indicators to be stored locally (Low/Medium/High)
OSINT_MIN_SEVERITY=Low
# Whether to persist OSINT hits to the local database
OSINT_STORE_LOCALLY=true


# ── VirusTotal [optional] ─────────────────────────────────────────────────────
# Enables malware hash lookups via the Hash Analysis tab.
# Free account: https://www.virustotal.com → Profile → API Key
#
VIRUSTOTAL_API_KEY=


# ── AlienVault OTX [optional] ─────────────────────────────────────────────────
# Adds AlienVault OTX threat intelligence to the feed.
# Free account: https://otx.alienvault.com → Settings → API Integration
#
OTX_API_KEY=


# ── MISP [optional] ───────────────────────────────────────────────────────────
# Connect to your own MISP instance for enterprise threat sharing.
# Requires a self-hosted MISP server.
#
MISP_URL=
MISP_API_KEY=


# ── Free Sources (always active — no key needed) ──────────────────────────────
# These data sources work out of the box with no configuration:
#   • Abuse.ch URLhaus   → https://urlhaus.abuse.ch
#   • Abuse.ch Bazaar    → https://bazaar.abuse.ch
#   • MITRE ATT&CK DB    → bundled in backend/data/mitre_attack.json
#   • MITRE D3FEND DB    → bundled in backend/data/mitre_defend.json
#   • NIST SP 800-53     → bundled in backend/data/nist_controls.json
#   • OWASP Top 10       → bundled in backend/data/owasp_data.json
